# Copy to .env and set IPGEOLOCATION_API_KEY before: docker compose up -d
# See docs/DEPLOYMENT-LAN.md for CORS and multi-device access.

IPGEOLOCATION_API_KEY=
NASA_API_KEY=DEMO_KEY

# Must match the browser URL exactly (host-only example):
CORS_ORIGINS=http://localhost:8000
# Multi-device on Wi-Fi (add your host LAN IP):
# CORS_ORIGINS=http://localhost:8000,http://192.168.1.100:8000

SERVE_STATIC=true
DATA_DIR=/app/data
FORECAST_CACHE_ENABLED=true
MOON_ENRICHMENT_ENABLED=false
NOCTUA_ENRICHMENT_ENABLED=false
SEVENTIMER_ENABLED=true
