IPGEOLOCATION_API_KEY=
FREEASTRO_API_KEY=
CORS_ORIGINS=http://localhost:5173
MOON_ENRICHMENT_ENABLED=true
MOON_VISUAL_MOON_COLOR=#E0E0E0
MOON_VISUAL_SHADOW_COLOR=#1a2030
FORECAST_CACHE_ENABLED=true
FORECAST_GEOCODE_TTL_HOURS=720
FORECAST_ASTRONOMY_TTL_HOURS=24
FORECAST_WEATHER_TTL_HOURS=3
SEVENTIMER_ENABLED=true
FORECAST_ASTRO_TTL_HOURS=3
SEVENTIMER_ALTITUDE_CORRECTION=0
NOCTUA_ENRICHMENT_ENABLED=false
NOCTUA_BASE_URL=https://api.noctuasky.com/api/v1
NOCTUA_REQUEST_TIMEOUT_SECONDS=12
NOCTUA_ENRICHMENT_BUDGET_SECONDS=5
NASA_API_KEY=DEMO_KEY
# Set false when a local system proxy breaks outbound API calls (403 on forecast search).
# HTTP_TRUST_ENV=false
# LIGHT_POLLUTION_GRID_PATH=data/light_pollution/world_atlas_grid.json

# Production (Docker / single-container deploy)
# SERVE_STATIC=true
# STATIC_DIR=static
